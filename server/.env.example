# Only examples – set real values in a private PM2 environment or secured environment file.
HOST=127.0.0.1
PORT=8790
DB_PATH=/home/ubuntu/arena-data/arena.sqlite
CORS_ORIGIN=https://caseycz.github.io
# Set to 1 only if the private NGINX proxy overwrites X-Real-IP with $remote_addr.
# TRUST_PROXY_REAL_IP=1
GOOGLE_CLIENT_ID=YOUR-WEB-OAUTH-CLIENT-ID.apps.googleusercontent.com
# Private directory outside the GitHub checkout and web root.
ARENA_REPORT_DIR=/home/ubuntu/arena-reports
# Only the Číselná aréna repository receives feedback.
# The live PM2 environment is configured separately; secrets stay private.
ARENA_GITHUB_REPO=CaseyCZ/Ciselna-Arena
# ARENA_GITHUB_ISSUES_TOKEN=SET_PRIVATE_GITHUB_ISSUE_TOKEN
# Set a random 32+ character token only for server-side/dashboard viewing.
# ARENA_REPORT_ADMIN_TOKEN=SET_A_LONG_RANDOM_PRIVATE_VALUE
