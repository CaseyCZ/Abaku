# Only examples – set real values in a private PM2 environment or /etc/abaku-api.env.
HOST=127.0.0.1
PORT=8790
DB_PATH=/home/ubuntu/abaku-data/abaku.sqlite
CORS_ORIGIN=https://caseycz.github.io
# Set to 1 only if the private NGINX proxy overwrites X-Real-IP with $remote_addr.
# TRUST_PROXY_REAL_IP=1
GOOGLE_CLIENT_ID=YOUR-WEB-OAUTH-CLIENT-ID.apps.googleusercontent.com
# Private directory outside the GitHub checkout and web root.
ABAKU_REPORT_DIR=/home/ubuntu/abaku-reports
# Switch to CaseyCZ/Ciselna-Arena only AFTER the repository is renamed.
# The live PM2 environment must be updated separately at that point.
ABAKU_GITHUB_REPO=CaseyCZ/Abaku
# Set a random 32+ character token only for server-side/dashboard viewing.
# ABAKU_REPORT_ADMIN_TOKEN=SET_A_LONG_RANDOM_PRIVATE_VALUE
